# Copy to .env and fill in. Never commit .env.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Self-hosted LiteLLM proxy (OpenAI-compatible). Leave blank to use the local rule-based summary.
LITELLM_BASE_URL=https://litellm.example.com/v1
LITELLM_API_KEY=
LITELLM_MODEL=
LITELLM_TIMEOUT_MS=20000

# Create demo users alice/bob and a sample project on start (demo only; disable for real use).
SEED_DEMO=true

# Set to true only when served over HTTPS (behind a TLS reverse proxy).
COOKIE_SECURE=false
TRUST_PROXY=false
