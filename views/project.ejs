<%- include('partials/head', { title: project.name }) %>
<%
  const money = (n) => Number(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const signed = (n) => (n > 0 ? '+' : '') + money(n);
  const pct = (p) => p === null ? 'n/a' : (p > 0 ? '+' : '') + p.toFixed(1) + '%';
  const tone = (v) => v > 0 ? 'over' : v < 0 ? 'under' : '';
  const t = summary.totals;
  const ai = project.ai_summary ? JSON.parse(project.ai_summary) : null;
  const statusIcon = { 'Over': '▲', 'Under': '▼', 'On budget': '●' };
  const statusClass = { 'Over': 'over', 'Under': 'under', 'On budget': 'onbudget' };
%>
<div id="project" data-project-id="<%= project.id %>">

<div class="page-head">
  <div>
    <p class="crumbs"><a href="/">Projects</a> /</p>
    <h1><%= project.name %></h1>
    <% if (project.description) { %><p class="muted"><%= project.description %></p><% } %>
  </div>
  <div class="actions">
    <button class="btn btn-primary" id="btn-pdf" type="button" <%= t.count ? '' : 'disabled' %>>Download PDF report</button>
    <a class="btn" href="/projects/<%= project.id %>/report.xlsx">Excel</a>
    <a class="btn" href="/projects/<%= project.id %>/report.csv">CSV</a>
  </div>
</div>

<section class="tiles" aria-label="Totals">
  <div class="tile"><span class="tile-k">Estimated cost</span><span class="tile-v"><%= money(t.estimated) %></span><span class="tile-s"><%= t.count %> line items</span></div>
  <div class="tile"><span class="tile-k">Actual cost</span><span class="tile-v"><%= money(t.actual) %></span><span class="tile-s"><%= summary.byCategory.length %> categories</span></div>
  <div class="tile"><span class="tile-k">Variance</span><span class="tile-v <%= tone(t.variance) %>"><%= signed(t.variance) %></span><span class="tile-s"><%= t.variance > 0 ? 'over budget' : t.variance < 0 ? 'under budget' : 'on budget' %></span></div>
  <div class="tile"><span class="tile-k">Variance %</span><span class="tile-v <%= tone(t.variance) %>"><%= pct(t.variancePct) %></span><span class="tile-s"><%= summary.counts.over %> over · <%= summary.counts.onBudget %> on · <%= summary.counts.under %> under</span></div>
</section>

<% if (t.count) { %>
<section class="charts">
  <figure class="card chart-card">
    <figcaption><h2>Estimated vs actual by category</h2>
      <div class="legend"><span><i class="sw sw-est"></i>Estimated</span><span><i class="sw sw-act"></i>Actual</span></div></figcaption>
    <div class="chart-box"><canvas id="chart-category" role="img" aria-label="Grouped bar chart of estimated and actual cost per category"></canvas></div>
  </figure>
  <figure class="card chart-card">
    <figcaption><h2>Variance by category</h2>
      <div class="legend"><span><i class="sw sw-over"></i>Over budget</span><span><i class="sw sw-under"></i>Under budget</span></div></figcaption>
    <div class="chart-box"><canvas id="chart-variance" role="img" aria-label="Bar chart of cost variance per category"></canvas></div>
  </figure>
  <figure class="card chart-card chart-wide">
    <figcaption><h2>Variance % per line item</h2>
      <div class="legend"><span><i class="sw sw-over"></i>Over budget</span><span><i class="sw sw-under"></i>Under budget</span><span><i class="sw sw-flag"></i>Flagged unusual</span></div></figcaption>
    <div class="chart-box chart-box-tall"><canvas id="chart-items" role="img" aria-label="Horizontal bar chart of variance percent for every line item"></canvas></div>
  </figure>
</section>

<div class="grid-2">
  <section class="card" id="ai">
    <div class="card-head">
      <h2>AI cost analysis</h2>
      <button class="btn btn-accent btn-sm" id="btn-ai" type="button"><%= ai ? 'Regenerate' : 'Generate summary' %></button>
    </div>
    <p class="muted small" id="ai-meta">
      <% if (ai) { %>
        <%= ai.source === 'ai' ? 'Generated by ' + (ai.model || 'AI') : (ai.note || 'Rule-based summary') %> · <%= project.ai_summary_at %> UTC
      <% } else { %>Summarises budget performance, key drivers and recommendations from aggregated figures.<% } %>
    </p>
    <div class="ai-text" id="ai-text" aria-live="polite"><%= ai ? ai.text : '' %></div>
    <p class="disclaimer small">AI output can be wrong. Check figures against the table before acting on them.</p>
  </section>

  <section class="card" id="anomalies">
    <h2>Unusual expenses <span class="count"><%= anomalies.length %></span></h2>
    <p class="muted small">Flagged when variance % is more than 2 standard deviations from the project mean, the overrun amount is above the IQR fence, or spend was unbudgeted.</p>
    <% if (!anomalies.length) { %>
      <p class="empty">Nothing unusual detected<%= t.count < 4 ? ' (need at least 4 items for statistics)' : '' %>.</p>
    <% } else { %>
      <ul class="anomaly-list">
      <% anomalies.forEach(a => { %>
        <li>
          <div class="anomaly-top"><span class="flag" aria-hidden="true">⚑</span><strong><%= a.item %></strong> <span class="muted">· <%= a.category %></span>
            <span class="anomaly-num <%= tone(a.variance) %>"><%= pct(a.variancePct) %></span></div>
          <ul class="reasons"><% a.reasons.forEach(r => { %><li><%= r %></li><% }) %></ul>
        </li>
      <% }) %>
      </ul>
    <% } %>
  </section>
</div>
<% } %>

<div class="grid-2" id="input">
  <section class="card">
    <h2>Add a line item</h2>
    <form method="post" action="/projects/<%= project.id %>/items" class="form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Category <input name="category" required maxlength="60" list="cats" placeholder="Labour"></label>
      <datalist id="cats"><% summary.byCategory.forEach(c => { %><option value="<%= c.category %>"><% }) %></datalist>
      <label>Item <input name="item" required maxlength="120" placeholder="Backend development"></label>
      <label>Estimated cost <input name="estimated" required inputmode="decimal" pattern="[0-9.,]+" placeholder="12000"></label>
      <label>Actual cost <input name="actual" required inputmode="decimal" pattern="[0-9.,]+" placeholder="13500"></label>
      <label>Date <input name="date" type="date"></label>
      <label>Notes <input name="notes" maxlength="500" placeholder="Optional"></label>
      <button class="btn btn-primary span-2" type="submit">Add item</button>
    </form>
  </section>

  <section class="card">
    <h2>Upload CSV or Excel</h2>
    <p class="muted small">Columns: <code>category, item, estimated, actual</code> and optionally <code>date, notes</code>. Max 2 MB, <%= maxRows.toLocaleString() %> rows. <a href="/template.csv">Download template</a></p>
    <form id="upload-form" class="upload">
      <label class="drop" id="drop">
        <input type="file" name="file" id="file" accept=".csv,.xlsx">
        <span id="drop-label">Choose a .csv or .xlsx file, or drop it here</span>
      </label>
      <button class="btn" type="submit">Validate &amp; preview</button>
    </form>
    <div id="upload-result" class="upload-result" hidden>
      <p id="upload-msg"></p>
      <ul id="upload-errors" class="upload-errors"></ul>
      <div class="table-wrap"><table class="data compact" id="preview-table"><thead><tr><th>Category</th><th>Item</th><th class="num">Estimated</th><th class="num">Actual</th><th class="num">Var %</th></tr></thead><tbody></tbody></table></div>
      <div class="row-gap">
        <button class="btn btn-primary btn-sm" id="commit-append" type="button">Import (append)</button>
        <button class="btn btn-sm" id="commit-replace" type="button">Import (replace existing)</button>
      </div>
    </div>
  </section>
</div>

<section class="card" id="items">
  <div class="card-head">
    <h2>Line items</h2>
    <% if (t.count) { %>
    <form method="post" action="/projects/<%= project.id %>/items/clear" class="inline confirm" data-confirm="Remove all line items from this project?">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-ghost btn-sm" type="submit">Clear all</button>
    </form>
    <% } %>
  </div>
  <% if (!t.count) { %>
    <p class="empty">No line items yet. Add one above or upload a file.</p>
  <% } else { %>
  <div class="table-wrap">
  <table class="data">
    <thead><tr><th>Category</th><th>Item</th><th class="num">Estimated</th><th class="num">Actual</th><th class="num">Variance</th><th class="num">Var %</th><th>Status</th><th>Date</th><th>Notes</th><th></th></tr></thead>
    <tbody>
    <% summary.lines.forEach(l => { %>
      <tr class="<%= flagged.has(l.id) ? 'is-flagged' : '' %>">
        <td><%= l.category %></td>
        <td><% if (flagged.has(l.id)) { %><span class="flag" title="Unusual expense">⚑</span> <% } %><%= l.item %></td>
        <td class="num"><%= money(l.estimated) %></td>
        <td class="num"><%= money(l.actual) %></td>
        <td class="num <%= tone(l.variance) %>"><%= signed(l.variance) %></td>
        <td class="num <%= tone(l.variance) %>"><%= pct(l.variancePct) %></td>
        <td><span class="pill pill-<%= statusClass[l.status] %>"><span aria-hidden="true"><%= statusIcon[l.status] %></span> <%= l.status %></span></td>
        <td class="nowrap"><%= l.date || '' %></td>
        <td class="notes"><%= l.notes %></td>
        <td>
          <form method="post" action="/projects/<%= project.id %>/items/<%= l.id %>/delete" class="inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="icon-btn" type="submit" aria-label="Delete <%= l.item %>">✕</button>
          </form>
        </td>
      </tr>
    <% }) %>
    </tbody>
    <tfoot><tr><th colspan="2">Total</th><th class="num"><%= money(t.estimated) %></th><th class="num"><%= money(t.actual) %></th><th class="num <%= tone(t.variance) %>"><%= signed(t.variance) %></th><th class="num <%= tone(t.variance) %>"><%= pct(t.variancePct) %></th><th colspan="4"></th></tr></tfoot>
  </table>
  </div>
  <% } %>
</section>

<section class="danger-zone">
  <form method="post" action="/projects/<%= project.id %>/delete" class="inline confirm" data-confirm="Delete this project and all its data?">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn btn-danger btn-sm" type="submit">Delete project</button>
  </form>
</section>
</div>
<script src="/static/vendor/chart.umd.min.js"></script>
<script src="/static/js/project.js"></script>
<%- include('partials/foot') %>
